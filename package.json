  "scripts": {
    "check": "npm run build:modules && node --input-type=module -e \"await import('./src/index.mjs')\"",
    "prepack": "npm run check:system && npm run check:brand && npm run check:support",
    "dev": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:brand": "node tools/check-brand.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "verify": "npm run check && npm test && npm run check:brand && npm run test:browser && npm run check:capabilities",
    "test:framework": "node tests/browser/frameworks.mjs",
    "verify:all": "npm run verify && npm run test:extended && npm run test:framework && npm run test:accessibility && npm run test:release && npm run test:scale && npm run test:distribution && npm run test:production && npm run test:consumer-types && npm run test:foundations && npm run test:migration && npm run test:consumer && npm run test:p3 && npm run check:system && npm run test:system && npm run test:principles && npm run test:workspace && npm run test:planning && npm run test:packed-planning && npm run test:readiness && npm run test:integration && npm run test:planning-next && npm run test:search-scale && npm run test:performance-profile",
