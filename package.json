    "test:production": "npm run build:modules && node tests/browser/production.mjs",
    "test:consumer-types": "node tools/check-consumer-types.mjs",
    "release:prepare": "node tools/prepare-release.mjs",
    "test:foundations": "npm run build:modules && node tests/browser/foundations.mjs",
    "test:migration": "npm run build:modules && node tests/browser/migration.mjs",
    "test:consumer": "npm run build:modules && node tests/browser/consumer.mjs",
    "test:p3": "npm run build:modules && npm run docs:build && node tests/browser/p3.mjs",
    "docs:build": "node tools/build-docs.mjs",
    "test:principles": "npm run build:modules && node tests/browser/principle-compliance.mjs",
