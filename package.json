{
  "name": "muhit-ui",
  "version": "0.8.0",
  "description": "Tema değişkenleri, erişilebilir etkileşimler ve şema tabanlı arayüz üretimi için bağımsız HTML/CSS/JavaScript bileşenleri.",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    },
    "./styles": "./styles/index.css",
    "./styles/*": "./styles/*",
    "./schemas/*": "./schemas/*",
    "./src/*": "./src/*",
    "./assets/fonts/*": "./assets/fonts/*",
    "./package.json": "./package.json",
    "./assets/brand/*": "./assets/brand/*",
    "./forms": {
      "types": "./types/forms.d.ts",
      "import": "./esm/forms.mjs",
      "default": "./esm/forms.mjs"
    },
    "./data-grid": {
      "types": "./types/data-grid.d.ts",
      "import": "./esm/data-grid.mjs",
      "default": "./esm/data-grid.mjs"
    },
    "./plot": {
      "types": "./types/plot.d.ts",
      "import": "./esm/plot.mjs",
      "default": "./esm/plot.mjs"
    },
    "./theme": {
      "types": "./types/theme.d.ts",
      "import": "./esm/theme.mjs",
      "default": "./esm/theme.mjs"
    },
    "./preferences": {
      "types": "./types/preferences.d.ts",
      "import": "./esm/preferences.mjs",
      "default": "./esm/preferences.mjs"
    },
    "./widgets": {
      "types": "./types/widgets.d.ts",
      "import": "./esm/widgets.mjs",
      "default": "./esm/widgets.mjs"
    },
    "./agent": {
      "types": "./types/agent.d.ts",
      "import": "./esm/agent.mjs",
      "default": "./esm/agent.mjs"
    },
    "./components": {
      "types": "./types/components.d.ts",
      "import": "./esm/components.mjs",
      "default": "./esm/components.mjs"
    },
    "./table": {
      "types": "./types/table.d.ts",
      "import": "./esm/table.mjs",
      "default": "./esm/table.mjs"
    },
    "./charts": {
      "types": "./types/charts.d.ts",
      "import": "./esm/charts.mjs",
      "default": "./esm/charts.mjs"
    },
    "./i18n": {
      "types": "./types/i18n.d.ts",
      "import": "./esm/i18n.mjs",
      "default": "./esm/i18n.mjs"
    }
  },
  "files": [
    "src/index.mjs",
    "src/components.js",
    "src/table.js",
    "src/charts.js",
    "src/theme.js",
    "src/agent.js",
    "styles/index.css",
    "styles/tokens.css",
    "styles/components.css",
    "styles/table.css",
    "styles/charts.css",
    "types",
    "schemas",
    "assets/fonts",
    "docs",
    "examples/basic.html",
    "examples/agent-view.json",
    "AGENTS.md",
    "llms.txt",
    "NOTICE",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "assets/brand",
    "src/widgets.js",
    "src/widget-schemas.js",
    "styles/widgets.css",
    "examples/widgets.json",
    "examples/workflow.html",
    "tools/check-brand.mjs",
    "styles/layouts.css",
    "examples/pages.html",
    "src/data-grid.js",
    "examples/react",
    "examples/vue",
    "examples/rich-agent.json",
    "src/forms.js",
    "src/preferences.js",
    "styles/forms.css",
    "examples/settings.html",
    "schemas/form.schema.json",
    "esm",
    "src/plot.js",
    "schemas/plot.schema.json",
    "tools/build-modules.mjs",
    "examples/workspace.html",
    "examples/extended-agent.json",
    "SECURITY.md",
    "src/i18n.js",
    "examples/international.html"
  ],
  "sideEffects": [
    "./src/*.js",
    "./styles/*.css"
  ],
  "scripts": {
    "check": "npm run build:modules && node --input-type=module -e \"await import('./src/index.mjs')\"",
    "prepack": "npm run check && npm run check:brand",
    "dev": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:brand": "node tools/check-brand.mjs",
    "test:browser": "node tests/browser/run.mjs",
    "verify": "npm run check && npm test && npm run check:brand && npm run test:browser",
    "test:framework": "node tests/browser/frameworks.mjs",
    "verify:all": "npm run verify && npm run test:extended && npm run test:framework && npm run test:accessibility",
    "build:modules": "node tools/build-modules.mjs",
    "pretest": "npm run build:modules",
    "test:extended": "npm run build:modules && node tests/browser/extended.mjs",
    "test:bundles": "npm run build:modules && node tools/check-bundles.mjs",
    "test:accessibility": "npm run build:modules && node tests/browser/accessibility.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "design-system",
    "css",
    "javascript",
    "themes",
    "components",
    "agent-ui"
  ],
  "devDependencies": {
    "axe-core": "4.14.0",
    "playwright": "1.62.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omasim/muhit.git"
  },
  "homepage": "https://github.com/omasim/muhit#readme",
  "bugs": {
    "url": "https://github.com/omasim/muhit/issues"
  }
}
